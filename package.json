{
  "name": "aaf-bot",
  "version": "1.0.0",
  "description": "Bot Discord de l'Académie Aéronautique Française — formation PTFS (pilotes et ATC).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/register-commands.ts",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-data.mjs"
  },
  "keywords": ["discord", "aviation", "ptfs", "aaf"],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
